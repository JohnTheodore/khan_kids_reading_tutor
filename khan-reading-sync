#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"

platform_tools="$repo_dir/private/android-sdk/platform-tools"
if [[ -x "$platform_tools/adb" ]]; then
  PATH="$platform_tools:$PATH"
  export PATH
fi

has_serial=false
has_student=false
show_help=false
for argument in "$@"; do
  case "$argument" in
    --serial|--serial=*) has_serial=true ;;
    --student|--student=*) has_student=true ;;
    -h|--help) show_help=true ;;
  esac
done

arguments=("$@")
if [[ "$show_help" == false && "$has_serial" == false ]]; then
  resolved_serial="$("$repo_dir/tools/run-python" tools/resolve_khan_device.py)"
  arguments+=(--serial "$resolved_serial")
fi
if [[ "$show_help" == false && "$has_student" == false ]]; then
  default_student="$(
    "$repo_dir/tools/run-python" tools/resolve_khan_device.py --field student
  )"
  arguments+=(--student "$default_student")
fi

exec "$repo_dir/tools/run-python" tools/reading_workflow.py "${arguments[@]}"
