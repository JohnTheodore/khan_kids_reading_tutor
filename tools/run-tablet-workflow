#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_dir"

mode="${1:-}"
if [[ -z "$mode" ]]; then
  printf 'usage: %s {connect|open|sync|mastery} [arguments...]\n' "$0" >&2
  exit 2
fi
shift

if [[ "$mode" == connect ]]; then
  exec "$repo_dir/tools/run-python" tools/resolve_khan_device.py "$@"
fi

case "$mode" in
  open)
    target=tools/open_khan_kids.py
    needs_student=false
    arguments=("$@")
    ;;
  sync)
    target=tools/reading_workflow.py
    needs_student=true
    arguments=("$@")
    ;;
  mastery)
    target=tools/reading_workflow.py
    needs_student=true
    arguments=(--sync "$@")
    ;;
  *)
    printf 'unknown tablet workflow: %s\n' "$mode" >&2
    exit 2
    ;;
esac

has_serial=false
has_student=false
show_help=false
for argument in "${arguments[@]}"; do
  case "$argument" in
    --serial|--serial=*) has_serial=true ;;
    --student|--student=*) has_student=true ;;
    -h|--help) show_help=true ;;
  esac
done

if [[ "$show_help" == false && "$has_serial" == false ]]; then
  resolved_serial="$("$repo_dir/tools/run-python" tools/resolve_khan_device.py)"
  arguments+=(--serial "$resolved_serial")
fi
if [[ "$show_help" == false && "$needs_student" == true && "$has_student" == false ]]; then
  default_student="$("$repo_dir/tools/run-python" tools/resolve_khan_device.py --field student)"
  arguments+=(--student "$default_student")
fi

exec "$repo_dir/tools/run-python" "$target" "${arguments[@]}"
